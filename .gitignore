# Restricted media remains excluded from public commits.
/assets/audio/*
/assets/fonts/golifez_bright_demo.otf
/assets/licenses/epidemic_sound_fire_effect.txt
/assets/licenses/golifez_bright_demo_eula.txt

# Local private-media import helpers and generated reports.
/tool/download_*_highlight.sh
/tool/import_*_highlight.sh
/tool/import_*_highlights.sh
/tool/import_japan_*.sh
/tool/organize_china_by_location.sh
/tool/generate_*_video_posters.swift

# Hardware CAD includes multi-gigabyte generated exports and third-party mesh
